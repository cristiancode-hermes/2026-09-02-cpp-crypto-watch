priority     : 300
refcnt       : 1
selftest     : passed
internal     : no
type         : skcipher
blocksize    : 16
ivsize       : 16
max keysize  : 32
geniv        : seqiv

name         : drbg_pr_sha256
driver       : drbg_pr_sha256
module       : drbg
priority     : 192
refcnt       : 0
selftest     : passed
internal     : yes
type         : rng
seedsize     : 32