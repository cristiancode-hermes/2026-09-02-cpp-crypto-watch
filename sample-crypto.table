# synthetic /proc/crypto dump (demo host with AES-NI + SHA-NI)
name         : sha256
driver       : sha256-ssse3
module       : sha256_ssse3
priority     : 250
refcnt       : 2
selftest     : passed
internal     : no
type         : shash
blocksize    : 64
digestsize   : 32

name         : aes
